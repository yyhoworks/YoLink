{
  "name": "yolink-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.13.0 || ^24.0.0 || >=26.0.0" },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "verify:generated": "node scripts/verify-generated.mjs",
    "check": "npm run typecheck && npm run test && npm run lint && npm run verify:generated",
    "preview": "node scripts/preview.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.9.1",
    "acorn": "8.15.0",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
