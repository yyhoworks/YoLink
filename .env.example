# Host port; Muvyo's original 7811 is not used.
STRMLINK_PORT=8796
# First-login password only. UI changes persist in data/admin-credential.json and take precedence.
# Leave blank for an auto-generated first-login password in data/initial-admin-password.txt.
STRMLINK_ADMIN_PASSWORD=
# Use an independent test directory for the first run.
STRMLINK_OUTPUT_DIR=./strm-test
# If necessary, use a reachable Go module mirror during build.
GOPROXY=https://proxy.golang.org,direct
